            VALUE "OriginalFilename", "CARL-HES.exe"
            VALUE "ProductName", "CARL-HES"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x280a, 1200
    END
END
